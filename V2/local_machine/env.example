# Local Machine Environment Configuration
# Copy this file to .env and modify the values

# Store Configuration
STORE_ID=Store001

# MQTT Configuration
MQTT_BROKER=103.87.67.139
MQTT_PORT=1883
MQTT_TOPIC=WHAC/Store001/in
MQTT_USERNAME=
MQTT_PASSWORD=

# Fingerprint Sensor Configuration
# For single sensor:
FINGERPRINT_PORT=/dev/serial0

# For multiple sensors (comma-separated ports):
# Example: FINGERPRINT_PORTS="/dev/ttyUSB0,/dev/ttyUSB1" or "/dev/serial0,/dev/serial1"
# FINGERPRINT_PORTS=/dev/serial0,/dev/ttyAMA2

BAUD_RATE=57600
CONFIDENCE_THRESHOLD=50

# Application Configuration
SCAN_INTERVAL=5
LOG_LEVEL=INFO


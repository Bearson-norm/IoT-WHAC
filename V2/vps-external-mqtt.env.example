# VPS Environment Configuration - External MQTT Broker
# Copy this file to .env and update with your values
# Command: cp vps-external-mqtt.env.example .env
# DO NOT commit .env to Git!

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres
DB_NAME=whac_master
DB_USER=postgres
# IMPORTANT: Change this password in production!
# Generate with: openssl rand -base64 32
DB_PASSWORD=ChangeThisToAStrongPassword123!
DB_PORT=5432

# ============================================
# MQTT BROKER CONFIGURATION (EXTERNAL)
# ============================================
# External MQTT Broker IP (already exists)
MQTT_BROKER=103.87.67.139
MQTT_PORT=1883

# ============================================
# MQTT TOPICS CONFIGURATION
# ============================================
# Topics for different functions
MQTT_ACTION_TOPIC=WHAC/Store001/action
MQTT_SCAN_TOPIC=WHAC/Store001/in
MQTT_AUDIO_TOPIC=WHAC/Store001/audio
MQTT_AUDIO_RESPONSE_TOPIC=WHAC/Store001/audio_response
MQTT_GPIO_LOG_TOPIC=WHAC/Store001/gpio_log
MQTT_VOICE_COMMAND_TOPIC=WHAC/Store001/voice_command
MQTT_VOICE_RESPONSE_TOPIC=WHAC/Store001/voice_response
MQTT_ALARM_TOPIC=WHAC/Store001/alarm

# For server/mqtt-processor (if used)
SCAN_TOPIC=WHAC/Store001/in
ACTION_TOPIC=WHAC/Store001/action
STATUS_TOPIC=WHAC/Store001/status

# ============================================
# WEB UI CONFIGURATION
# ============================================
# External access port (akan dimap ke port 5000 internal)
WEB_PORT=4545

# Flask Environment (production/development)
FLASK_ENV=production

# IMPORTANT: Change this to a long random string in production!
# Generate with: openssl rand -hex 64
SECRET_KEY=ChangeThisSecretKeyToALongRandomStringInProduction456!

# ============================================
# STORE/DEVICE CONFIGURATION
# ============================================
STORE_ID=Store001

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# DEPLOYMENT NOTES
# ============================================
# 1. Copy this file: cp vps-external-mqtt.env.example .env
# 2. Edit .env and change:
#    - DB_PASSWORD (use strong password)
#    - SECRET_KEY (generate random string)
# 3. Set secure permissions: chmod 600 .env
# 4. Never commit .env to Git (add to .gitignore)
#
# Generate secure passwords:
#   openssl rand -base64 32  # For DB_PASSWORD
#   openssl rand -hex 64     # For SECRET_KEY
#
# Deploy command:
#   docker-compose -f docker-compose.vps-external-mqtt.yml --env-file .env up -d
#
# Check logs:
#   docker-compose -f docker-compose.vps-external-mqtt.yml logs -f
#
# Stop services:
#   docker-compose -f docker-compose.vps-external-mqtt.yml down
#
# ============================================
# SECURITY CHECKLIST
# ============================================
# [ ] Changed DB_PASSWORD to strong password
# [ ] Changed SECRET_KEY to random string
# [ ] Set file permission: chmod 600 .env
# [ ] Added .env to .gitignore
# [ ] Configured firewall (UFW) to allow port 4545
# [ ] Verified MQTT broker is accessible from VPS
# [ ] SSL/HTTPS configured (optional but recommended)



